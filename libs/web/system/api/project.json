{
  "name": "system-api",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/system/api/src",
  "prefix": "hs",
  "projectType": "library",
  "tags": ["scope:web", "domain:system", "type:api"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/system/api/ng-package.json",
        "tsConfig": "libs/web/system/api/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/system/api/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    }
  }
}

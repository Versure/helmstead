{
  "name": "system-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/system/data-access/src",
  "prefix": "hs",
  "projectType": "library",
  "tags": ["scope:web", "domain:system", "type:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/system/data-access/ng-package.json",
        "tsConfig": "libs/web/system/data-access/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/system/data-access/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "setupFiles": ["tools/testing/no-network.ts"],
        "exclude": ["**/*.live.spec.ts"]
      },
      "configurations": {
        "live": {
          "include": ["**/*.live.spec.ts"],
          "exclude": []
        }
      }
    }
  }
}

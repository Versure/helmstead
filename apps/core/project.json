{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core/src",
  "projectType": "application",
  "tags": ["scope:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "dotnet build apps/core/Helmstead.Core.slnx --nologo"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet test apps/core/Helmstead.Core.slnx --no-build --nologo"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "dotnet format apps/core/Helmstead.Core.slnx --verify-no-changes"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "dotnet run --project apps/core/src/Helmstead.Core.Api --launch-profile http"
      }
    }
  }
}

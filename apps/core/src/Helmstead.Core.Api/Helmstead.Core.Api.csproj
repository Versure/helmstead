<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The OpenAPI document is produced at build time and committed as the contract with the web app. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../../libs/api-contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helmstead.Core.Domain\Helmstead.Core.Domain.csproj" />
    <ProjectReference Include="..\Helmstead.Core.Persistence\Helmstead.Core.Persistence.csproj" />
  </ItemGroup>

</Project>
